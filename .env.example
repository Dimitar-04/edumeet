# Optional for local Docker use. When empty, Compose uses a development-only key.
JWT_SIGNING_KEY=

# Optional. Maps location search is unavailable when this is empty.
# Restrict a supplied browser key to http://localhost:5173/* in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Registration still works without these values, but its email cannot
# be delivered. Use a Gmail address and Google App Password when enabling it.
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
